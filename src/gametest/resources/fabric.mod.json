{
	"schemaVersion": 1,
	"id": "jujutsumod-gametest",
	"version": "1.0.0",
	"name": "Jujutsu Mod GameTests",
	"description": "Isolated GameTest mod for the Jujutsu Minecraft mod: server canaries (issue #42 Stage A) and client canaries (issue #42 Stage B).",
	"environment": "*",
	"entrypoints": {
		"fabric-gametest": [
			"jujutsu.mod.gametest.ServerGameTests",
			"jujutsu.mod.gametest.TodoAimedSwapGameTests",
			"jujutsu.mod.gametest.TodoAimedSwapRollbackGameTests"
		],
		"fabric-client-gametest": [
			"jujutsu.mod.gametest.client.ClientLoadCanaryTest",
			"jujutsu.mod.gametest.client.ClientObservationCanaryTest"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.8",
		"jujutsumod": "*"
	}
}
